# -----------------------------------------------------------------------------
# Personal Intelligence Platform — Environment Variables
# Copy to .env and fill. All are optional unless marked REQUIRED.
# See config/sources.yaml for per-source enable/disable.
# -----------------------------------------------------------------------------

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
NEWSLETTER_TIMEZONE=Asia/Kolkata  # your 10pm IST preference; also set per-user via API/DB
NEWSLETTER_DATA_DIR=./data
DATABASE_URL=  # leave empty for SQLite dev; prod: postgresql+psycopg://user:pass@host/db

# --- P0: Source APIs (REQUIRED for live fetch) ---
# Tavily — web/news/social search (https://app.tavily.com/home → API Keys → Create)
TAVILY_API_KEY=your_tavily_api_key

# LLM — pick one provider (Groq is default; set LLM_PROVIDER to switch)
# Groq — https://console.groq.com/keys → Create API Key (free tier)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq  # groq | openai | anthropic
# OpenAI — https://platform.openai.com/api-keys → Create new secret key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key

# Anthropic — https://console.anthropic.com/settings/keys → Create Key (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Embeddings / Reranker
EMBEDDING_PROVIDER=local:all-MiniLM-L6-v2  # local or openai/cohere
RERANKER_PROVIDER=  # cohere | none
COHERE_API_KEY=your_cohere_api_key  # https://dashboard.cohere.com/api-keys → Create trial key

# --- P0: GitHub (optional but recommended for higher rate limit) ---
# https://github.com/settings/tokens → Generate new token (classic) → no scopes needed for search (5000/hr vs 60/hr)
GITHUB_TOKEN=your_github_pat

# OpenAlex polite pool (optional, better rate limit + support open science)
# https://docs.openalex.org/how-to-use-the-api/rate-limits → just set your email
OPENALEX_EMAIL=your_email@example.com

# --- P0: Hugging Face / Arxiv / HN / Reddit (no key needed) ---
# Hugging Face, Arxiv, Hacker News work without keys. Reddit via Tavily, no separate key.

# --- P1/P2: Optional keys (enable sources in config/sources.yaml when you have them) ---

# Product Hunt — https://www.producthunt.com/v2/oauth/applications → Create → get token (for startups feed)
PRODUCT_HUNT_TOKEN=your_product_hunt_token

# YouTube Data API — https://console.cloud.google.com/apis/library/youtube.googleapis.com → Enable → Credentials → Create API Key
# Needed for youtube connector (secondary evidence, talks/demos). Captions have auth constraints.
YOUTUBE_API_KEY=your_youtube_api_key

# Email delivery — pick SMTP (Gmail) OR Resend API
# SMTP (Gmail App Password) — https://myaccount.google.com/apppasswords → Create (16 chars, remove spaces)
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASS=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TO=recipient_email@example.com  # defaults to SMTP_USER if empty
EMAIL_PROVIDER=smtp  # smtp | resend

# Resend API — https://resend.com/api-keys → Create API Key (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=your_resend_api_key

# Telegram ops alerts (optional)
# https://t.me/BotFather → /newbot → copy token; then /getChatId via https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Delivery preference (10pm IST default, adaptive + user-selectable) ---
# User can override via DB: UserPreference.delivery_time + timezone (API: POST /users/{id}/preferences)
# Adaptive learner: app/workers/delivery.adaptive_send_window() learns typical open time from UserInteraction.
# Set here as fallback when no user pref exists.
DIGEST_DELIVERY_TIME=22:00  # HH:MM in NEWSLETTER_TIMEZONE (your 10pm IST)
DIGEST_ADAPTIVE=true  # true → learn from opens/clicks; false → fixed time

# --- Frontier labs are RSS — no keys needed ---
# Official labs (10 feeds) in config/sources.yaml: openai, anthropic, deepmind, google-research, meta-ai, nvidia, microsoft-research, mistral, cohere, xai
# All enabled by default; comment out any feed in config/sources.yaml to disable.

# --- How to enable more sources ---
# Edit config/sources.yaml: set enabled: true for any P1/P2 source.
# Examples:
#   regulation.enabled: true   (NIST/EU feeds, no key)
#   security.enabled: true     (NVD/CISA, no key)
#   youtube.enabled: true      (needs YOUTUBE_API_KEY)
#   startups.enabled: true     (needs PRODUCT_HUNT_TOKEN)
